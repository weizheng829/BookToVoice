# 复制本文件为 .env 并按需修改。
# 注意：.env 已在 .gitignore 中，切勿将真实值提交到仓库。

# ---- 合成默认参数 ----
DEFAULT_VOICE=zh-CN-XiaoxiaoNeural
DEFAULT_RATE=+0%
DEFAULT_PITCH=+0Hz

# ---- Worker ----
NARRATE_TITLE_DEFAULT=true
MAX_RETRIES=3
RETRY_BACKOFF_BASE=5
WORKER_IDLE_SLEEP=2

# ---- 存储路径（留空则使用代码内的默认值）----
# INPUT_DIR=
# OUTPUT_DIR=
# DB_PATH=
